program="../custom_dollar"
chronicles_sinks="textlines[stdout]"
chronicles_colors=None
chronicles_timestamps=None
chronicles_thread_ids=None
chronicles_line_endings=Posix
[Output]
stdout="""INF forwarding proc                            procForwarded="(b: 2)"
INF forwarding proc seq                        procForwardedSeq="[(b: 2)]"
INF multiline proc                             multiline="first line\nsecond line"
INF quoting proc                               quoting="say \"hi\""
INF forwarding proc
  procForwarded: (b: 2)

INF forwarding proc seq
  procForwardedSeq: [
                      (b: 2)
                    ]

INF multiline proc
  multiline: first line
             second line

INF quoting proc
  quoting: say \"hi\"

"""
